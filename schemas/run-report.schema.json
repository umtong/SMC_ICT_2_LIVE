{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run report",
  "type": "object",
  "required": [
    "schema_version",
    "epoch_id",
    "lane_id",
    "task_id",
    "base_revision",
    "status",
    "started_at",
    "ended_at",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "epoch_id": {
      "type": "string"
    },
    "lane_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "GOAL_MET",
        "TIME_LIMIT",
        "INVALID",
        "FAILED",
        "PARTIAL"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
