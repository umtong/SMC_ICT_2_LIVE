{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable Research Result",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "claim_id",
    "worker_id",
    "status",
    "summary",
    "evaluation_contract_sha256",
    "artifact_fingerprint",
    "dependency_fingerprint",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "result_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "worker_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["VALID", "CANDIDATE", "INVALID", "SUPERSEDED"]},
    "summary": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dataset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "code_commit": {"type": "string"},
    "evaluation_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
