{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset registry entry",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
