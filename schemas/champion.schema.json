{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Champion state",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "status",
    "champion_id",
    "candidate_type",
    "source_result_id",
    "source_pull_request",
    "qualification_stage",
    "target_status",
    "selection_reason",
    "comparison_confidence",
    "metrics",
    "known_weaknesses",
    "component_leaders",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "revision": {"type": "integer", "minimum": 0},
    "status": {
      "enum": ["NONE", "RESEARCH_CHAMPION", "VALIDATED_CHAMPION"]
    },
    "champion_id": {"type": ["string", "null"]},
    "candidate_type": {"enum": ["NONE", "STRATEGY", "PORTFOLIO"]},
    "source_result_id": {"type": ["string", "null"]},
    "source_pull_request": {"type": ["string", "null"]},
    "qualification_stage": {
      "enum": [
        "NONE",
        "EXPLORATORY",
        "BASIC_COST_SURVIVING",
        "OUT_OF_SAMPLE_SURVIVING",
        "DEEP_VALIDATED",
        "PRACTICAL_USE"
      ]
    },
    "target_status": {"enum": ["NOT_MET", "MET"]},
    "selection_reason": {"type": "string", "minLength": 1},
    "comparison_confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "metrics": {"type": "object"},
    "known_weaknesses": {
      "type": "array",
      "items": {"type": "string"}
    },
    "component_leaders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "leader_id", "source_result_id", "reason"],
        "properties": {
          "component": {"type": "string"},
          "leader_id": {"type": "string"},
          "source_result_id": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
