{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Champion state",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "status",
    "champion_id",
    "reason",
    "evidence",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "NONE",
        "CANDIDATE",
        "VALIDATED"
      ]
    },
    "champion_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
