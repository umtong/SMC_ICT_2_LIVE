+def attach_funding_mark_proxy(
+    bars1m: pd.DataFrame, funding: pd.DataFrame
+) -> pd.DataFrame:
+    """Attach a causal funding-time value proxy and drop pre-market events.
+
+    The canonical calendar includes rows before ETHUSDT observations begin and
+    can include isolated missing minutes.  Funding before the first observed
+    market price cannot affect any eligible position and is discarded.  Every
+    later event uses the last *observed* one-minute close available at the
+    funding timestamp rather than the last calendar row.
+    """
+    available = bars1m.available_at_ms.to_numpy(np.int64)
+    observed = bars1m.observed.to_numpy(bool)
+    closes = bars1m.close.to_numpy(float)
+    valid_bar = observed & np.isfinite(closes) & (closes > 0)
+    if not valid_bar.any():
+        raise EconomicError("canonical one-minute market has no observed price")
+    observed_available = available[valid_bar]
+    observed_closes = closes[valid_bar]
+
+    output = funding[
+        funding.timestamp_ms >= int(observed_available[0])
+    ].copy()
+    ftime = output.timestamp_ms.to_numpy(np.int64)
+    fidx = np.searchsorted(observed_available, ftime, side="right") - 1
+    if (fidx < 0).any():
+        raise EconomicError("funding event lacks a prior observed price")
+    prices = observed_closes[fidx]
+    if not np.isfinite(prices).all() or (prices <= 0).any():
+        raise EconomicError("funding mark proxy is invalid")
+    output["mark_price_proxy"] = prices
+    return output
+
+
