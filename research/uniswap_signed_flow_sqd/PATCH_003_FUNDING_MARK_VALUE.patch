+def funding_cashflow(
+    funding_times: np.ndarray,
+    funding_rate_price_prefix: np.ndarray,
+    *,
+    side: int,
+    quantity: float,
+    start_ms: int,
+    end_ms: int,
+) -> float:
+    """Signed funding PnL using funding-time marked position value."""
+    left = int(np.searchsorted(funding_times, start_ms, side="right"))
+    right = int(np.searchsorted(funding_times, end_ms, side="right"))
+    rate_price = float(
+        funding_rate_price_prefix[right] - funding_rate_price_prefix[left]
+    )
+    return -float(side) * float(quantity) * rate_price
+
